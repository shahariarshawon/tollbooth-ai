// Tollbooth AI database schema. See docs/database/database-design.md for the rationale.
//
// Conventions
// - Primary keys are UUIDs generated by PostgreSQL (gen_random_uuid()).
// - Every tenant-owned table carries tenantId. Where a row references another tenant-owned row
//   (project, API key), a composite foreign key (id, tenantId) makes cross-tenant links impossible.
// - Money is Decimal, never Float. Token prices are USD per 1,000,000 tokens.
// - Configuration rows cascade with their tenant. Financial and audit rows are RESTRICTed: tenants
//   are retired with status = DELETED rather than hard-deleted.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, citext]
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum TenantPlan {
  FREE
  STARTUP
  BUSINESS
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  DEVELOPER
  FINANCE
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

enum ProviderType {
  OPENAI
  ANTHROPIC
  GOOGLE
}

enum ProviderStatus {
  ACTIVE
  DISABLED
}

enum AiRequestStatus {
  SUCCESS
  FAILED
  BLOCKED
}

enum UsageEventType {
  REQUEST_COMPLETED
  REQUEST_FAILED
  BUDGET_ALERT
}

enum LedgerTransactionType {
  AI_USAGE
  CREDIT
  REFUND
  ADJUSTMENT
}

// ---------------------------------------------------------------------------
// Tenancy and identity
// ---------------------------------------------------------------------------

model Tenant {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyName String       @db.VarChar(200)
  slug        String       @unique @db.VarChar(63)
  plan        TenantPlan   @default(FREE)
  status      TenantStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  users         User[]
  projects      Project[]
  apiKeys       ApiKey[]
  aiRequests    AiRequest[]
  usageEvents   UsageEvent[]
  ledgerEntries LedgerEntry[]
  auditLogs     AuditLog[]
  alerts        Alert[]

  @@map("tenants")
}

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Null only for SUPER_ADMIN (platform staff). Enforced by a CHECK constraint.
  tenantId     String?    @db.Uuid
  email        String     @unique @db.Citext
  passwordHash String
  firstName    String     @db.VarChar(100)
  lastName     String     @db.VarChar(100)
  role         UserRole   @default(DEVELOPER)
  status       UserStatus @default(INVITED)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)

  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]

  @@index([tenantId])
  @@map("users")
}

// Opaque refresh tokens, stored as SHA-256 hashes. Each login starts a family; every rotation
// revokes the presented token and issues a new one in the same family. Presenting a revoked
// token is treated as theft and revokes the whole family.
model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  familyId  String    @db.Uuid
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime  @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Project {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String        @db.Uuid
  name        String        @db.VarChar(200)
  description String?
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  apiKeys    ApiKey[]
  aiRequests AiRequest[]

  // Target of composite foreign keys from ApiKey and AiRequest.
  @@unique([id, tenantId])
  @@unique([tenantId, name])
  @@map("projects")
}

model ApiKey {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String       @db.Uuid
  projectId   String       @db.Uuid
  // SHA-256 hex digest of the raw key. The raw key is shown once at creation and never stored.
  keyHash     String       @unique @db.VarChar(64)
  // First characters of the raw key, safe to display so people can tell keys apart.
  keyPrefix   String       @db.VarChar(16)
  name        String       @db.VarChar(200)
  // Scopes granted to the key, e.g. "chat:completions".
  permissions String[]     @default([])
  // Requests per minute. Null means "use the tenant plan default".
  rateLimit   Int?
  expiresAt   DateTime?    @db.Timestamptz(3)
  lastUsedAt  DateTime?    @db.Timestamptz(3)
  status      ApiKeyStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project    Project     @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Cascade)
  aiRequests AiRequest[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([projectId])
  @@map("api_keys")
}

// ---------------------------------------------------------------------------
// Provider and model catalogue (platform-wide, not tenant-owned)
// ---------------------------------------------------------------------------

model AiProvider {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String         @unique @db.VarChar(100)
  type          ProviderType
  status        ProviderStatus @default(ACTIVE)
  // Non-secret settings only (base URL, timeouts). Credentials come from the environment or a secret manager.
  configuration Json           @default("{}")
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)

  models AiModel[]

  @@map("ai_providers")
}

model AiModel {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId       String   @db.Uuid
  modelName        String   @db.VarChar(100)
  // USD per 1,000,000 tokens.
  inputTokenPrice  Decimal  @db.Decimal(12, 6)
  outputTokenPrice Decimal  @db.Decimal(12, 6)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  provider AiProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@unique([providerId, modelName])
  @@map("ai_models")
}

// ---------------------------------------------------------------------------
// Gateway traffic, usage and money (append-only)
// ---------------------------------------------------------------------------

model AiRequest {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String          @db.Uuid
  projectId      String          @db.Uuid
  apiKeyId       String          @db.Uuid
  // provider and model are snapshots, so history survives catalogue changes.
  provider       ProviderType
  model          String          @db.VarChar(100)
  requestTokens  Int             @default(0)
  responseTokens Int             @default(0)
  totalTokens    Int             @default(0)
  latencyMs      Int?
  // USD, computed from AiModel prices at request time.
  estimatedCost  Decimal         @default(0) @db.Decimal(18, 8)
  status         AiRequestStatus
  errorMessage   String?
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project       Project       @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Restrict)
  apiKey        ApiKey        @relation(fields: [apiKeyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  usageEvents   UsageEvent[]
  ledgerEntries LedgerEntry[]

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([apiKeyId])
  @@index([provider, model])
  @@map("ai_requests")
}

model UsageEvent {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String         @db.Uuid
  // Null for events not tied to a request, such as budget alerts.
  requestId String?        @db.Uuid
  eventType UsageEventType
  tokens    Int            @default(0)
  cost      Decimal        @default(0) @db.Decimal(18, 8)
  metadata  Json           @default("{}")
  createdAt DateTime       @default(now()) @db.Timestamptz(3)

  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  request AiRequest? @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([requestId])
  @@map("usage_events")
}

// Append-only. Corrections are new REFUND or ADJUSTMENT rows, never updates.
// Sign convention: negative amount = charge to the tenant (AI_USAGE); positive = credit to the tenant.
model LedgerEntry {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String                @db.Uuid
  requestId       String?               @db.Uuid
  transactionType LedgerTransactionType
  amount          Decimal               @db.Decimal(18, 8)
  currency        String                @default("USD") @db.Char(3)
  description     String?
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)

  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  request AiRequest? @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([requestId])
  @@map("ledger_entries")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Null for platform-level events: unknown-email login failures and SUPER_ADMIN actions.
  tenantId   String?  @db.Uuid
  // Null when the actor was the system, or the user has since been deleted.
  userId     String?  @db.Uuid
  // Free-form constant such as API_KEY_CREATED. A string, so new actions need no migration.
  action     String   @db.VarChar(100)
  resource   String   @db.VarChar(100)
  resourceId String?  @db.VarChar(100)
  metadata   Json     @default("{}")
  ipAddress  String?  @db.Inet
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([userId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Alerts (Phase 11)
// ---------------------------------------------------------------------------

enum AlertType {
  BUDGET_LIMIT
  HIGH_USAGE
  PROVIDER_ERROR
  SECURITY_ALERT
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  UNREAD
  READ
}

// Written by the gateway when it detects the event (budget, provider, security); read and marked read
// by the control plane for the dashboard. The same cross-service-via-shared-table pattern as
// AiRequest/LedgerEntry (Phase 7) and the data Phase 10's analytics reads.
model Alert {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String        @db.Uuid
  type      AlertType
  message   String
  severity  AlertSeverity @default(WARNING)
  status    AlertStatus   @default(UNREAD)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  readAt    DateTime?     @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt(sort: Desc)])
  @@map("alerts")
}
