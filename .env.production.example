# ── Runtime ────────────────────────────────────────────────────────────────────
NODE_ENV=production

# ── Database (PostgreSQL) ──────────────────────────────────────────────────────
# Used by docker-compose.prod.yml to configure the postgres container and connection strings.
POSTGRES_DB=tollbooth
POSTGRES_USER=tollbooth
POSTGRES_PASSWORD=<strong-random-password>

# ── Auth ────────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 48
JWT_SECRET=<at-least-32-char-random-secret>
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
BCRYPT_ROUNDS=12

# ── AI Providers ───────────────────────────────────────────────────────────────
# Required: Gemini is the active default provider.
GOOGLE_AI_API_KEY=<your-google-ai-api-key>
# Optional overrides (leave empty for default endpoints)
GOOGLE_AI_BASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Gateway tuning ────────────────────────────────────────────────────────────
GATEWAY_MAX_TOKENS=4096
GATEWAY_PROVIDER_TIMEOUT_MS=30000
GATEWAY_MAX_PROVIDER_RETRIES=3
GATEWAY_SECURITY_TIMEOUT_MS=3000
GATEWAY_SECURITY_FAIL_OPEN=false
GATEWAY_FAIL_OPEN=false
GATEWAY_CIRCUIT_FAILURE_THRESHOLD=5
GATEWAY_CIRCUIT_OPEN_MS=30000

# ── Observability ─────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=<strong-random-password>
GRAFANA_ADMIN_USER=admin
GRAFANA_ROOT_URL=http://localhost:3030

# ── Nginx ─────────────────────────────────────────────────────────────────────
HTTP_PORT=80

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_PORT=3030

# ── Image tagging (optional) ──────────────────────────────────────────────────
TAG=latest
