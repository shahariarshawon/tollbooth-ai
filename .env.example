# Runtime
NODE_ENV=development
PORT=3000
# Gateway port. Falls back to PORT when empty.
GATEWAY_PORT=
# Largest max_tokens a client may request, and how long to wait for an AI provider (ms).
GATEWAY_MAX_TOKENS=4096
GATEWAY_PROVIDER_TIMEOUT_MS=60000

# Connection strings (match docker-compose.yml defaults)
DATABASE_URL=postgresql://tollbooth:tollbooth_dev_password@localhost:5432/tollbooth?schema=public
REDIS_URL=redis://localhost:6379
# Host port docker compose publishes Redis on. Change it (and REDIS_URL) if 6379 is already in use.
REDIS_PORT=6379

# Redis for the gateway. Either leave these empty and it uses REDIS_URL, or set REDIS_HOST and it uses
# REDIS_HOST, REDIS_PORT (above) and REDIS_PASSWORD instead. REDIS_URL can also carry a password
# (redis://:password@host:6379) or TLS (rediss://).
REDIS_HOST=
REDIS_PASSWORD=
# true when the Redis server requires TLS and you are using the discrete settings above.
REDIS_TLS=false
# A Redis command slower than this (ms) fails, so a struggling Redis cannot stall requests.
REDIS_COMMAND_TIMEOUT_MS=1000
# If Redis is unreachable: false rejects AI requests with 503 (limits and budgets cannot be enforced),
# true lets them through unlimited. Keep false unless availability matters more than cost control.
GATEWAY_FAIL_OPEN=false
# Circuit breaker: consecutive provider failures that open it, and how long it stays open (ms).
GATEWAY_CIRCUIT_FAILURE_THRESHOLD=5
GATEWAY_CIRCUIT_OPEN_MS=30000
KAFKA_BROKER=localhost:9094

# Auth
# JWT_SECRET must be at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=
# Durations: a number and a unit (s, m, h, d)
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
# bcrypt cost factor (10-15). Higher is slower and stronger.
BCRYPT_ROUNDS=12

# Dashboard (Next.js). These are read from apps/dashboard/.env.local, not this file.
#   CONTROL_PLANE_URL=http://localhost:3001   where the dashboard server reaches the control plane
#   NEXT_PUBLIC_MOCK_API=false                turn off the in-browser mock for projects, API keys and stats

# AI providers. The gateway routes each model to a provider (see docs/architecture/provider-architecture.md).
# Gemini is the active provider: get a key at https://aistudio.google.com/apikey. None of the providers is
# mandatory to start the gateway, but a provider without a key cannot serve requests.
GOOGLE_AI_API_KEY=
# Leave empty for https://generativelanguage.googleapis.com/v1beta
GOOGLE_AI_BASE_URL=
# Which provider serves a model that several active providers offer: gemini, openai or anthropic.
GATEWAY_DEFAULT_PROVIDER=gemini

# Ready for later, switched off in the database until their provider row is set to ACTIVE.
OPENAI_API_KEY=
# Leave empty for https://api.openai.com/v1. Point at any OpenAI-compatible server (or a local fake).
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
# Leave empty for https://api.anthropic.com
ANTHROPIC_BASE_URL=

# Docker Compose infrastructure credentials (local development only)
# Host port for Postgres. Change it (and DATABASE_URL) if 5432 is already in use.
POSTGRES_PORT=5432
POSTGRES_DB=tollbooth
POSTGRES_USER=tollbooth
POSTGRES_PASSWORD=tollbooth_dev_password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
